APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleet_onboarding
POSTGRES_PORT=5432

# Host-local URL (tests / Alembic on the host). Docker Compose overrides this for the API service.
DATABASE_URL=postgresql+asyncpg://fleet:change-me@localhost:5432/fleet_onboarding

# Vehicle verification. Keep `fake` unless pointing at API Setu or the local mock.
VEHICLE_VERIFICATION_PROVIDER=fake
API_SETU_BASE_URL=
API_SETU_API_KEY=
API_SETU_CLIENT_ID=
API_SETU_TIMEOUT_SECONDS=10
API_SETU_MAX_ATTEMPTS=3
API_SETU_BACKOFF_SECONDS=0.2

# Local mock API Setu: `make mock-api-setu` (Docker Compose service on port 8099).
# Point the Compose API at it with:
#   VEHICLE_VERIFICATION_PROVIDER=api_setu
#   API_SETU_BASE_URL=http://mock-api-setu:8099/vahan/rc
#   API_SETU_API_KEY=test-api-key
#   API_SETU_CLIENT_ID=test-client
MOCK_API_SETU_API_KEY=test-api-key
MOCK_API_SETU_HOST=0.0.0.0
MOCK_API_SETU_PORT=8099
